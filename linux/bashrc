# Omarchy: its env-bootstrap must run even for non-interactive shells
if [ -r /usr/share/omarchy/default/bash/env-bootstrap ]; then
    source /usr/share/omarchy/default/bash/env-bootstrap
    OMARCHY=1
fi

# Tools installed per user (~/.local/bin) and Pi's Node.js, also for commands
# run over SSH without a terminal
export PATH="$HOME/.local/bin:$HOME/.local/share/pi-node/current/bin:$PATH"

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

if [ -n "$OMARCHY" ]; then
    # Starship prompt, eza/zoxide aliases, mise, fzf, readline tweaks
    source "$OMARCHY_PATH/default/bash/rc"
else
    # History
    HISTSIZE=10000
    HISTFILESIZE=20000
    HISTCONTROL=ignoredups:erasedups
    shopt -s histappend

    # Check window size after each command
    shopt -s checkwinsize

    # Prompt - cyan container ID when Docker, yellow hostname when SSH'd
    if [ -f /.dockerenv ]; then
        _container_id=$(hostname)
        PS1='\[\033[38;5;81m\]'"$_container_id"'\[\033[0m\] \[\033[38;5;167m\]ϟ\[\033[0m\] \[\033[1;38;5;240m\]\w\[\033[0m\] '
    elif [ -n "$SSH_CONNECTION" ]; then
        PS1='\[\033[38;5;226m\](\h)\[\033[0m\] \[\033[38;5;167m\]ϟ\[\033[0m\] \[\033[1;38;5;240m\]\w\[\033[0m\] '
    else
        PS1='\[\033[38;5;167m\]ϟ\[\033[0m\] \[\033[1;38;5;240m\]\w\[\033[0m\] '
    fi

    # Notify terminal of working directory (for tmux pane_current_path)
    PROMPT_COMMAND='printf "\033]7;file://%s%s\033\\\\" "$HOSTNAME" "$PWD"'

    alias ls='ls --color=auto'

    # Terminal
    export TERM=xterm-256color

    # Bash completion
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    fi

    # fzf
    command -v fzf &>/dev/null && eval "$(fzf --bash)"
fi

# Aliases
alias la='ls -la'
alias ll='ls -lah'
alias grep='grep --color=auto'
alias lg="lazygit"

# Editor
if command -v nvim &>/dev/null; then
    alias vim="nvim"
    alias vi="nvim"
    export EDITOR="nvim"
elif command -v vim &>/dev/null; then
    export EDITOR="vim"
else
    export EDITOR="vi"
fi
