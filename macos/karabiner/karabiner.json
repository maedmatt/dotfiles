                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "any": "key_code",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "conditions": [
                                            {
                                                "input_sources": [
